{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@saas/database$": "<rootDir>/../../../packages/database/src",
    "^@saas/shared$": "<rootDir>/../../../packages/shared/src"
  },
  "setupFiles": ["<rootDir>/setup.ts"]
}
