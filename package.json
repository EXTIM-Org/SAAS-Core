{
  "name": "saas-core-platform",
  "private": true,
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.17.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:all": "pnpm services:up && pnpm dev",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit --project apps/api/tsconfig.json && tsc --noEmit --project apps/dashboard/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
