# Copy this file to .env for local development.
# Never commit .env.
#
# These values intentionally match docker-compose.yml.

# -----------------------------
# PostgreSQL
# -----------------------------
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas-local-password
POSTGRES_DB=saas

# Used by applications running directly on the host.
DATABASE_URL=postgresql://saas:saas-local-password@127.0.0.1:5432/saas?schema=public

# Used by applications running inside Docker Compose.
DATABASE_URL_DOCKER=postgresql://saas:saas-local-password@postgres:5432/saas?schema=public

# -----------------------------
# Redis
# -----------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_URL_DOCKER=redis://redis:6379

# -----------------------------
# Typesense
# -----------------------------
TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_URL_DOCKER=http://typesense:8108
TYPESENSE_API_KEY=dev-typesense-admin-key-change-me

# -----------------------------
# Application
# -----------------------------
NODE_ENV=development

# Generate real random values for local use when auth is implemented.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-characters

# Local application URLs
MARKETING_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
API_URL=http://localhost:4000
SEARCH_API_URL=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SEARCH_API_URL=http://localhost:4001

# -----------------------------
# Billing (Phase 3)
# -----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
